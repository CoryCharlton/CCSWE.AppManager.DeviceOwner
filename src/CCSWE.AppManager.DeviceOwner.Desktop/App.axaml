<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CCSWE.AppManager.DeviceOwner.Desktop.App"
             xmlns:theme="using:CCSWE.Avalonia.Material"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <!-- Standalone Material 3 theme: supplies the whole control surface itself, no separate base theme required. -->
        <theme:MaterialTheme DensityStyle="Compact" />

        <!-- App card convention: the standard surface is an elevated Card with a 1px OutlineVariant hairline.
             Defined once here so every Classes="Elevated" Card matches. -->
        <Style Selector="theme|Card.Elevated">
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariant}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://CCSWE.AppManager.DeviceOwner.Desktop/Themes/Icons.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
