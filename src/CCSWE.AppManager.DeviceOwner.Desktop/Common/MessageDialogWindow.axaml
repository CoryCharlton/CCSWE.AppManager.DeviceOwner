<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:common="using:CCSWE.AppManager.DeviceOwner.Desktop.Common"
        x:Class="CCSWE.AppManager.DeviceOwner.Desktop.Common.MessageDialogWindow"
        x:DataType="common:MessageDialogViewModel"
        Title="{Binding Title}"
        Width="440" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface}">

    <StackPanel Margin="24" Spacing="20">
        <TextBlock Classes="TitleMedium" Foreground="{DynamicResource OnSurface}"
                   Text="{Binding Title}" TextWrapping="Wrap"/>
        <TextBlock Classes="BodyMedium" Foreground="{DynamicResource OnSurfaceVariant}"
                   Text="{Binding Message}" TextWrapping="Wrap"/>

        <Button Classes="Filled" HorizontalAlignment="Right" Content="Close" Command="{Binding CloseCommand}"/>
    </StackPanel>

</Window>
